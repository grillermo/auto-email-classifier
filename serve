#!/usr/bin/env bash
# (Re)start auto-email-classifier on :3001 in tmux session
# "auto-email-classifier", in place, and return. Run by
# ~/c/server/after-reboot.sh at boot and by ./activate after git-sync lands
# new code. Public at auto-email-classifier.chiq.me (Caddy :3000 -> :3001).
set -euo pipefail
APP_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$APP_DIR"
# shellcheck disable=SC2034 # read by serve-in-place.sh
SESSION=auto-email-classifier
# shellcheck source=/dev/null
. "$HOME/c/server/serve-in-place.sh"
serve_require_clean_main
serve_load_env
export RAILS_ENV=production

echo "==> bundle install";      bundle install --quiet
echo "==> assets:precompile";   bin/rails assets:precompile
echo "==> db:migrate";          bin/rails db:migrate

# Solid Queue runs inside Puma as threads (async mode, see config/puma.rb).
# Retire the old separate jobs pane if it is still running.
serve_stop jobs
# Tuned for RAM, not throughput: usually one person uses it at a time, so 2
# Puma threads are plenty, and a lower GC heap growth factor stops Ruby from
# reserving far more heap than it needs (default 1.8).
serve_pane web 3001 "env RAILS_ENV=production SOLID_QUEUE_IN_PUMA=1 RAILS_MAX_THREADS=2 RUBY_GC_HEAP_GROWTH_FACTOR=1.1 bin/rails server -p 3001" /up
echo "==> auto-email-classifier: web $(serve_lan_url 3001)"
serve_attach
