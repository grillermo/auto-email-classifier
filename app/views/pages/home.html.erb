<% content_for :title, "Auto Email Classifier" %>
<% content_for :hide_app_header, true unless user_signed_in? %>
<% content_for :full_width, true %>

<div class="min-h-screen bg-surface text-on-surface">
  <% unless user_signed_in? %>
  <header class="sticky top-0 z-50 bg-surface/90 backdrop-blur-xl">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
      <a href="<%= root_path %>" class="flex flex-row items-center gap-2" aria-label="Auto Email Classifier home">
        <%= image_tag 'logo.svg', class: "h-8 w-auto mr-2", alt: "" %>
        <span class="font-headline text-lg font-extrabold tracking-tight text-on-surface sm:text-xl">auto-email-classifier</span>
      </a>

      <nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
        <a class="text-sm font-semibold text-on-surface-variant transition-colors hover:text-on-surface" href="#features">Features</a>
        <a class="text-sm font-semibold text-on-surface-variant transition-colors hover:text-on-surface" href="<%= privacy_path %>">Privacy</a>
      </nav>

      <div class="flex items-center gap-3">
        <%= google_oauth_button_to "Continue with Google",
          user_google_oauth2_omniauth_authorize_path,
          button_class: "hidden sm:inline-flex",
          form_class: "hidden sm:block" %>
      </div>
    </div>
    <div class="h-px bg-surface-container-low"></div>
  </header>
  <% end %>

  <section class="relative overflow-hidden px-6 pb-20 pt-20 lg:pb-28 lg:pt-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 lg:grid-cols-2">
      <div class="relative z-10">
        <h1 class="font-headline text-5xl font-extrabold leading-[1.05] tracking-tight text-on-surface md:text-6xl">
          Your inbox,<br>
          <span class="text-secondary">curated with precision.</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-8 text-on-surface-variant">
          Automate Gmail with ordered rules that label, archive, triage, and clean up messages before they interrupt your day.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <% if user_signed_in? %>
            <a href="<%= rules_path %>" class="inline-flex items-center gap-2 rounded-md bg-gradient-to-r from-primary to-primary-dim px-8 py-4 font-headline text-base font-extrabold text-on-primary shadow-lg transition-transform active:scale-95">
              <span>Open rules</span>
              <span class="material-symbols-outlined">mark_email_read</span>
            </a>
          <% else %>
            <%= google_oauth_button_to "Continue with Google",
              user_google_oauth2_omniauth_authorize_path,
              button_class: "h-12 min-w-[220px] px-4" %>
          <% end %>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-tr from-secondary/10 to-primary/5 blur-3xl"></div>
        <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest shadow-2xl ring-1 ring-outline-variant/15">
          <div class="flex items-center justify-between bg-surface-container-low px-6 py-4">
            <div class="flex gap-2">
              <span class="h-3 w-3 rounded-full bg-error/25"></span>
              <span class="h-3 w-3 rounded-full bg-secondary-container"></span>
              <span class="h-3 w-3 rounded-full bg-primary/25"></span>
            </div>
            <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-outline">Active classifiers</span>
          </div>

          <div class="space-y-4 p-6">
            <div class="group flex items-center justify-between rounded-lg bg-surface-container-lowest p-3 transition-colors hover:bg-surface-container-low/60">
              <div class="flex items-center gap-4">
                <span class="material-symbols-outlined text-outline-variant transition-colors group-hover:text-primary">drag_indicator</span>
                <div>
                  <div class="text-sm font-bold">Priority Clients</div>
                  <div class="text-[11px] text-on-surface-variant">Matches sender domain: @luxury.com</div>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="rounded-full bg-secondary-container px-2 py-0.5 text-[10px] font-extrabold text-on-secondary-container">LABEL: VIP</span>
                <span class="material-symbols-outlined text-sm text-secondary" style="font-variation-settings: 'FILL' 1;">check_circle</span>
              </div>
            </div>

            <div class="flex items-center justify-between rounded-lg bg-surface-container-lowest p-3 transition-colors hover:bg-surface-container-low/60">
              <div class="flex items-center gap-4">
                <span class="material-symbols-outlined text-outline-variant">drag_indicator</span>
                <div>
                  <div class="text-sm font-bold">Invoice Archive</div>
                  <div class="text-[11px] text-on-surface-variant">Contains "Invoice" and an attachment</div>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="rounded-full bg-surface-container-high px-2 py-0.5 text-[10px] font-extrabold text-on-surface-variant">ARCHIVE</span>
                <span class="material-symbols-outlined text-sm text-secondary" style="font-variation-settings: 'FILL' 1;">check_circle</span>
              </div>
            </div>

            <div class="mt-8 rounded-xl bg-surface-container-low p-5">
              <div class="mb-3 flex items-center gap-2 text-[10px] font-extrabold uppercase tracking-wider text-primary">
                <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
                Impact preview
              </div>
              <div class="space-y-2">
                <div class="flex h-9 items-center justify-between rounded bg-surface-container-lowest px-4">
                  <span class="h-2 w-32 rounded-full bg-outline-variant/30"></span>
                  <span class="rounded-full bg-secondary-container px-2 py-0.5 text-[10px] font-bold text-on-secondary-container">7 emails</span>
                </div>
                <div class="flex h-9 items-center justify-between rounded bg-surface-container-lowest px-4">
                  <span class="h-2 w-48 rounded-full bg-outline-variant/30"></span>
                  <span class="rounded-full bg-secondary-container px-2 py-0.5 text-[10px] font-bold text-on-secondary-container">clean</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="bg-surface-container-low/30 px-6 py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <h2 class="font-headline text-3xl font-extrabold tracking-tight">Precision engineering for your inbox</h2>
        <p class="mt-4 text-on-surface-variant">A quiet workspace for rules that handle real Gmail volume without turning into another noisy dashboard.</p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
        <article class="rounded-xl bg-surface-container-lowest p-10 shadow-sm md:col-span-8">
          <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <span class="material-symbols-outlined">account_tree</span>
          </div>
          <h3 class="font-headline text-2xl font-extrabold">Smart rule builder</h3>
          <p class="mt-4 max-w-xl leading-7 text-on-surface-variant">Combine sender metadata, subject terms, body content, and attachments to trigger labels, read states, trash actions, and custom scripts.</p>

          <div class="mt-10 grid gap-4 sm:grid-cols-3">
            <div class="rounded-xl bg-surface-container-low p-4 text-center">
              <div class="mb-1 text-xs font-extrabold uppercase text-primary">Conditions</div>
              <div class="text-[11px] text-on-surface-variant">If body contains "Receipt"</div>
            </div>
            <div class="rounded-xl bg-surface-container-low p-4 text-center">
              <div class="mb-1 text-xs font-extrabold uppercase text-primary">Actions</div>
              <div class="text-[11px] text-on-surface-variant">Apply "Finance" label</div>
            </div>
            <div class="rounded-xl bg-surface-container-low p-4 text-center">
              <div class="mb-1 text-xs font-extrabold uppercase text-primary">Output</div>
              <div class="text-[11px] text-on-surface-variant">Mark as read</div>
            </div>
          </div>
        </article>

        <article class="flex rounded-xl bg-primary p-10 text-on-primary shadow-xl md:col-span-4">
          <div class="flex min-h-80 flex-col">
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-white/10">
              <span class="material-symbols-outlined">sync</span>
            </div>
            <h3 class="font-headline text-2xl font-extrabold text-white">Background automation</h3>
            <p class="mt-4 leading-7 text-on-primary/80">Rules run on schedule so Gmail stays organized while you work elsewhere.</p>
            <div class="mt-auto flex items-center justify-between pt-8">
              <span class="text-sm font-semibold">Sync status</span>
              <span class="flex items-center gap-2 text-xs font-extrabold text-secondary-fixed">
                <span class="h-2 w-2 rounded-full bg-secondary-fixed"></span>
                LIVE
              </span>
            </div>
          </div>
        </article>

        <article class="rounded-xl bg-surface-container-lowest p-10 shadow-sm md:col-span-4">
          <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-tertiary-container/10 text-tertiary">
            <span class="material-symbols-outlined">low_priority</span>
          </div>
          <h3 class="font-headline text-xl font-extrabold">Priority processing</h3>
          <p class="mt-3 text-sm leading-7 text-on-surface-variant">Drag active rules into the exact order you want so specific filters run before broad catch-all cleanup.</p>
        </article>

        <article id="workflow" class="overflow-hidden rounded-xl bg-surface-container-high/40 p-10 md:col-span-8">
          <div class="grid gap-8 md:grid-cols-[1fr_1.1fr] md:items-center">
            <div>
              <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-secondary/10 text-secondary">
                <span class="material-symbols-outlined">visibility</span>
              </div>
              <h3 class="font-headline text-xl font-extrabold">Live impact preview</h3>
              <p class="mt-3 text-sm leading-7 text-on-surface-variant">Review which recent messages a rule will affect before saving it, then apply immediately when the match looks right.</p>
            </div>
            <div class="rounded-xl bg-surface-container-lowest p-4 shadow-inner">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="h-2 w-24 rounded-full bg-surface-container-high"></span>
                  <span class="h-4 w-12 rounded-full bg-secondary-container"></span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="h-2 w-16 rounded-full bg-surface-container-high"></span>
                  <span class="h-4 w-12 rounded-full bg-secondary-container"></span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="h-2 w-32 rounded-full bg-surface-container-high"></span>
                  <span class="h-4 w-12 rounded-full bg-secondary-container"></span>
                </div>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="px-6 py-20">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 rounded-xl bg-surface-container-lowest p-10 shadow-sm md:flex-row md:items-center">
      <div>
        <h2 class="font-headline text-3xl font-extrabold tracking-tight">Give Gmail a curator.</h2>
        <p class="mt-3 max-w-2xl text-on-surface-variant">Connect Google, define the rule order, and let the classifier keep your inbox ready for the next thing that matters.</p>
      </div>
      <% if user_signed_in? %>
        <a href="<%= rules_path %>" class="inline-flex shrink-0 items-center gap-2 rounded-md bg-gradient-to-r from-primary to-primary-dim px-7 py-4 font-headline font-extrabold text-on-primary shadow-lg transition-transform active:scale-95">
          <span>Open rules</span>
          <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      <% else %>
        <%= google_oauth_button_to "Continue with Google",
          user_google_oauth2_omniauth_authorize_path,
          button_class: "h-12 min-w-[220px] shrink-0 px-4" %>
      <% end %>
    </div>
  </section>

  <footer class="bg-surface px-6 py-16">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col justify-between gap-12 md:flex-row">
        <div class="max-w-xs">
          <div class="mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined text-2xl text-secondary" style="font-variation-settings: 'FILL' 1;">article</span>
            <span class="font-headline text-lg font-extrabold">auto-email-classifier</span>
          </div>
          <p class="text-sm leading-7 text-on-surface-variant">Email automation with an editorial eye: precise, private, and built for quiet productivity.</p>
        </div>

        <div class="grid grid-cols-2 gap-12 sm:grid-cols-3">
          <div>
            <div class="mb-4 text-[10px] font-extrabold uppercase tracking-widest text-primary">Product</div>
            <ul class="space-y-2 text-xs text-on-surface-variant">
              <li><a class="transition-colors hover:text-secondary" href="#features">Features</a></li>
            </ul>
          </div>
          <div>
            <div class="mb-4 text-[10px] font-extrabold uppercase tracking-widest text-primary">Company</div>
            <ul class="space-y-2 text-xs text-on-surface-variant">
              <li><a class="transition-colors hover:text-secondary" href="<%= privacy_path %>">Privacy Policy</a></li>
              <li><a class="transition-colors hover:text-secondary" href="<%= terms_of_service_path %>">Terms of Service</a></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="mt-12 flex flex-col justify-between gap-4 pt-8 text-[10px] uppercase tracking-widest text-on-surface-variant md:flex-row md:items-center">
        <p>2026 auto-email-classifier. All rights reserved.</p>
      </div>
    </div>
  </footer>
</div>
